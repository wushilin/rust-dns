; Sample BIND-format zone for import:
;   Console: zone page -> Import BIND
;   API:     see examples/api/05-import-export.sh
; SOA lines are ignored on import; zone SOA settings come from rust-dns.
$ORIGIN example.com.
$TTL 3600
@       IN SOA  ns1.example.com. hostmaster.example.com. 2026092701 3600 600 1209600 300
@       IN NS   ns1.example.com.
@       IN NS   ns2.example.com.
ns1     IN A    192.0.2.53
ns2     IN A    192.0.2.54
@       IN A    192.0.2.10
@       IN AAAA 2001:db8::10
www     300 IN CNAME example.com.
@       IN MX   10 mail.example.com.
mail    IN A    192.0.2.25
@       IN TXT  "v=spf1 mx -all"
_dmarc  IN TXT  "v=DMARC1; p=reject; rua=mailto:dmarc@example.com"
@       IN CAA  0 issue "letsencrypt.org"
_sip._tcp IN SRV 10 60 5060 sip.example.com.
sip     IN A    192.0.2.30
*.apps  IN A    192.0.2.40
